# ==============================================================
# CONFIGURAÇÕES DO BOT LOTERIAS BRASIL (WHATSAPP CHANNEL)
# ==============================================================

# Provedor da API de WhatsApp:
# Opções: "evolution" (Evolution API v2), "zapi" (Z-API) ou "meta" (Meta Cloud API)
WHATSAPP_PROVIDER=evolution

# URL base da sua API de WhatsApp (sem barra no final)
# Exemplo Evolution API: https://evolution.seudominio.com
# Exemplo Z-API: https://api.z-api.io
WHATSAPP_API_URL=https://evolution.seudominio.com

# Nome da Instância no provedor
WHATSAPP_INSTANCE_ID=loterias-brasil

# Chave de API ou Token do WhatsApp
WHATSAPP_API_KEY=sua_chave_de_api_secreta

# JID do Canal do WhatsApp (Newsletters no WhatsApp terminam com @newsletter)
# Exemplo: 120363045678901234@newsletter
WHATSAPP_CHANNEL_ID=120363045678901234@newsletter

# Loterias monitoradas (separadas por vírgula):
# Opções válidas: megasena, lotofacil, quina, lotomania, diadesorte
LOTTERIES=megasena,lotofacil,quina,lotomania,diadesorte

# Mecanismo de persistência para evitar reenvios duplicados:
# "json" (salva em data/lottery_state.json) ou "sqlite" (salva em data/lotteries.db)
STORAGE_TYPE=json
STORAGE_FILE_PATH=data/lottery_state.json

# Fuso horário oficial dos sorteios das Loterias Caixa
TIMEZONE=America/Sao_Paulo

# Janela de monitoramento noturno (horas cheias em Horário de Brasília)
SCHEDULE_START_HOUR=20
SCHEDULE_END_HOUR=22
CHECK_INTERVAL_MINUTES=30
