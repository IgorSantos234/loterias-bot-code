# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# CONFIGURAÇÕES DO BOT LOTERIAS BRASIL
# ==========================================

# Provedor da API de WhatsApp: "evolution" (Evolution API v2), "zapi" (Z-API) ou "meta" (Cloud API)
WHATSAPP_PROVIDER="evolution"

# URL base da API (ex: https://evolution.seudominio.com ou https://api.z-api.io)
WHATSAPP_API_URL="https://evolution.seudominio.com"

# Nome ou ID da instância conectada ao WhatsApp
WHATSAPP_INSTANCE_ID="loterias-brasil"

# Chave de API / Token de Autenticação
WHATSAPP_API_KEY="sua_chave_de_api_aqui"

# JID ou ID do Canal (WhatsApp Newsletter / Channel) "Loterias Brasil"
# No WhatsApp, canais usam o sufixo @newsletter (ex: 120363045678901234@newsletter)
WHATSAPP_CHANNEL_ID="120363045678901234@newsletter"

# Loterias monitoradas separadas por vírgula (megasena,lotofacil,quina,lotomania,diadesorte)
LOTTERIES="megasena,lotofacil,quina,lotomania,diadesorte"

# Estratégia de armazenamento para deduplicação ("json" ou "sqlite")
STORAGE_TYPE="json"
STORAGE_FILE_PATH="./data/lottery_state.json"

# Fuso horário para os sorteios (horário de Brasília)
TIMEZONE="America/Sao_Paulo"

# Horário de monitoramento noturno (início e fim em horas cheias)
SCHEDULE_START_HOUR="20"
SCHEDULE_END_HOUR="22"
CHECK_INTERVAL_MINUTES="30"

